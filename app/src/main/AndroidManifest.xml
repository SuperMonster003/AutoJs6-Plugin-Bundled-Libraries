<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        A resource-only plugin (host roadmap T11 / P4.3): AutoJs6 reads assets/script-modules.json and the files under
        assets/modules straight from this APK, so no script call ever starts this process.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_icon_studio_application"
        android:supportsRtl="true">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data android:name="org.autojs.plugin.WAKE_ACTIVITY" android:value=".WakeActivity" />
        <meta-data android:name="org.autojs.plugin.info.AUTHOR" android:value="SuperMonster003" />
        <meta-data android:name="org.autojs.plugin.scriptModules.CATALOG" android:value="script-modules.json" />
        <meta-data android:name="requiresHostVersion" android:value="${requiredHostVersion}" />

        <!-- The launch page of the Plugin Center entry: one switch per library (default on). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.BundledLibraries">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReleaseHistoryActivity"
            android:exported="false"
            android:label="@string/text_release_history"
            android:theme="@style/Theme.BundledLibraries" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            One switch per library (host roadmap Q100): the settings page disables the alias of a library that is
            switched off, and AutoJs6 lists the enabled ones with a single PackageManager query. The aliases are never
            started; their target only finishes.
        -->
        <activity-alias
            android:name=".library.axios"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="axios" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.cheerio"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="cheerio" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.dayjs"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="dayjs" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.i18n"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="i18n" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.pangu"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
