            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="os" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.path"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="path" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.process"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="process" />
