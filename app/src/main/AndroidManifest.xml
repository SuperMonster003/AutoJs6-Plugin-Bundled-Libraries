                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".library.buffer"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="buffer" />
