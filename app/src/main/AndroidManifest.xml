        </activity-alias>

        <activity-alias
            android:name=".library.nodejs"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:targetActivity=".WakeActivity">
            <meta-data android:name="org.autojs.plugin.scriptModules.LIBRARY" android:value="nodejs" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SCRIPT_MODULE_LIBRARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".BundledLibrariesInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data android:name="requiresHostVersion" android:value="${requiredHostVersion}" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="script-modules" />
            </intent-filter>
        </service>

    </application>

</manifest>
